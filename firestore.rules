rules_version = '2';
// Regole di sicurezza Firestore per OpenMguesser (incollale in Firebase Console → Firestore → Regole).
//
// Ospiti (accesso anonimo): i loro documenti hanno `expiresAt` entro 14 giorni e vengono
// cancellati dalla policy TTL. Account Google: `expiresAt` è null e i dati restano.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isGuest() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    // Scadenza non oltre N giorni da adesso (un giorno di margine per l'orologio del client).
    function expiresWithin(days) {
      return request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(days, 'd');
    }
    // Ospite: deve scadere entro 15 giorni. Account Google: nessuna scadenza.
    function retentionOk() {
      return isGuest() ? expiresWithin(15) : request.resource.data.expiresAt == null;
    }

    // Profilo: ognuno scrive solo il proprio.
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9_ -]{3,20}$')
        && request.resource.data.icon is string && request.resource.data.icon.size() <= 8
        && retentionOk();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Classifica: solo creazione, mai modifica. L'utente può cancellare i propri punteggi.
    match /scores/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total <= 25000
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9_ -]{3,20}$')
        && request.resource.data.createdAt == request.time
        && retentionOk();
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Stanze 1 contro 1: durano al massimo 2 giorni.
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest == null
        && request.resource.data.spots.size() <= 5
        && expiresWithin(2);
      allow update: if signedIn() && (
        resource.data.host == request.auth.uid ||
        (resource.data.guest == null
          && request.resource.data.guest == request.auth.uid
          && request.resource.data.spots == resource.data.spots
          && request.resource.data.host == resource.data.host)
      );
      allow delete: if false;

      match /guesses/{gid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.round is int
          && gid == request.auth.uid + '_' + string(request.resource.data.round)
          && expiresWithin(2);
        allow update, delete: if false;
      }
    }
  }
}
